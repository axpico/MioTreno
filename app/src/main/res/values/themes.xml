<resources>
    <!-- La finestra ha già il colore di fondo del tema prima che Compose disegni: niente flash. -->
    <style name="Theme.MioTreno.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mt_bg</item>
        <item name="android:colorAccent">@color/mt_accento</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/mt_barre_chiare</item>
    </style>

    <style name="Theme.MioTreno" parent="Theme.MioTreno.Base" />

    <!-- Splash animato (core-splashscreen, nativo da Android 12): il treno entra e frena. -->
    <style name="Theme.MioTreno.Avvio" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mt_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_animato</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="windowSplashScreenIconBackgroundColor">#DDE1FF</item>
        <item name="postSplashScreenTheme">@style/Theme.MioTreno</item>
    </style>
</resources>
